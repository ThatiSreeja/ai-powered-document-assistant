# Copy the API variables to backend/.env and frontend/.env as needed.
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/document_assistant?charset=utf8mb4
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
VITE_API_URL=http://localhost:5000/api
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
